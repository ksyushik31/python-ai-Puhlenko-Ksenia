# Извлекает данные о национальных парках: название, страна, площадь (в квадратных километрах), дата основания, самая высокая точка и статус Всемирного наследия ЮНЕСКО.
# Extracts data about national parks: name, country, area (in square kilometers), founding date, highest point, and UNESCO World Heritage status.

SELECT
  ?parkLabel
  ?countryLabel
  ?areaKm2
  ?inception
  ?highestPointLabel
  ?unescoStatusLabel
WHERE {
  ?park wdt:P31 wd:Q46169.  # Национальный парк
  ?park wdt:P17 ?country.   # Страна
  ?park p:P2046 ?areaStatement. # Узел с данными о площади
  ?areaStatement psv:P2046 ?areaValueNode. # Значение площади
  ?areaValueNode wikibase:quantityAmount ?areaValue. # Числовое значение площади
  OPTIONAL { ?areaValueNode wikibase:quantityUnit ?unit. } # Единица измерения (опционально)

  # Конвертируем площадь в квадратные километры
  BIND(IF(BOUND(?unit) && ?unit = wd:Q828224, ?areaValue, # Если единица уже квадратные километры
           IF(BOUND(?unit) && ?unit = wd:Q712226, ?areaValue / 100, # Если единица гектары, конвертируем в квадратные километры
           IF(BOUND(?unit) && ?unit = wd:Q7727, ?areaValue / 1000000, # Если единица квадратные метры, конвертируем в квадратные километры
           ?areaValue))) AS ?areaKm2) # Иначе оставляем как есть

  OPTIONAL { ?park wdt:P571 ?inception. }          # Дата основания (опционально)
  OPTIONAL { ?park wdt:P610 ?highestPoint. }       # Самая высокая точка (опционально)
  OPTIONAL { ?park wdt:P1435 ?unescoStatus. }      # Статус Всемирного наследия ЮНЕСКО (опционально)

  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". } # Метки на русском и английском
}
