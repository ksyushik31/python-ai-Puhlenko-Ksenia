SELECT DISTINCT ?park ?parkLabel ?country ?countryLabel ?area ?inception ?highestPoint ?highestPointLabel ?elevation WHERE {
  ?park wdt:P31 wd:Q46169;  # Национальный парк
           wdt:P17 ?country;  # Страна
           wdt:P2046 ?area.   # Площадь

  OPTIONAL { ?park wdt:P571 ?inception. }    # Дата основания (опционально)
  OPTIONAL { ?park wdt:P610 ?highestPoint. } # Самая высокая точка (опционально)
  OPTIONAL { ?park wdt:P2044 ?elevation. }   # Высота над уровнем моря (опционально)

  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru, en" }
}
